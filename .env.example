# Conexion Redis
REDIS_URL=redis://localhost:6379/0

# Mecanismo de guarda (gating): umbral de la norma ‖ΔM(t)‖₂
EPSILON=150.0

# Optimizacion
INTERVALO_OPT_SEG=300      # cada cuanto corre el job de despacho (5 min)
HORIZONTE_MIN=60           # horizonte deslizante del MILP (minutos)
BLOQUE_MIN=5               # granularidad temporal de la ventana

# Flota / recursos finitos
FLOTA_TOTAL=120
CONDUCTORES_DISPONIBLES=140
CAPACIDAD_BUS=160

# App
LOG_LEVEL=INFO
